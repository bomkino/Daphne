{
  "name": "daphne-explainer",
  "version": "0.1.0",
  "description": "Daphne: the hype explainer for social, in Remotion",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@remotion/media": "4.0.532",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.532",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "score": "python3 scripts/make_score.py",
    "render": "node scripts/render.mjs",
    "render:cine": "node scripts/render.mjs --cine",
    "preview": "node scripts/render.mjs --preview",
    "sheet": "node scripts/sheet.mjs",
    "machine": "node scripts/machine.mjs",
    "lint": "eslint src && tsc",
    "test": "node --test scripts/*.test.mjs",
    "laurels": "node scripts/laurels.mjs"
  }
